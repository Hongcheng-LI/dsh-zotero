{
  "name": "dsh-zotero-local",
  "version": "0.3.0",
  "description": "Zotero tools for DeepSeek Harness via the Zotero local API (no API key): search your library, read metadata and PDF full text, retrieve query-relevant passages with page anchors, read PDF annotations, export BibTeX/RIS/CSL JSON citations, and get one-shot item digests.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "tsc",
    "prepublishOnly": "pnpm run build",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "test:smoke": "npm run build && node --test test/smoke.mjs",
    "audit": "node tools/audit.mjs ."
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "zotero",
    "reference-manager",
    "research"
  ],
  "author": "lhc",
  "license": "MIT",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1 || >=0.2.1-alpha.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hongcheng-LI/dsh-zotero"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3"
  }
}
